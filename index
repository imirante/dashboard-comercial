  const body=document.getElementById('compBody');
  if(body) body.innerHTML=MONTHS.map((m,i)=>{
    const v26=D.mesValor[i][1];
    const v25=D.mes2025[i][1];
    const d=delta(v25,v26);
    return`<tr>
      <td><strong>${m} 2026</strong></td>
      <td style="color:var(--gray-400)">${fR(v25)}</td>
      <td>${fR(v26)}</td>
      <td class="${d.cls}">${fR(v26-v25)}</td>
      <td class="${d.cls}">${d.str}</td>
      <td>${D.mesVendas[i][1]}</td>
      <td>${D.mesClientes[i][1]}</td>
      <td>${fR(D.mesTicket[i][1])}</td></tr>`;
  }).join('');

  const tcBody=document.getElementById('ticketCompBody');
  if(tcBody) tcBody.innerHTML=MONTHS.map((m,i)=>{
    const t26=D.mesTicket[i][1];
    const t25=D.ticket2025[i][1];
    const d=delta(t25,t26);
    return`<tr><td>${m}</td><td style="color:var(--gray-400)">${fR(t25)}</td><td>${fR(t26)}</td><td class="${d.cls}">${d.str}</td></tr>`;
  }).join('');

  mkChart('cComp','bar',MONTHS,[
    {label:'2025 (est.)',data:D.mes2025.map(m=>m[1]),backgroundColor:'rgba(136,135,128,.3)',borderColor:'rgba(136,135,128,.6)',borderWidth:1},
    {label:'2026',data:D.mesValor.map(m=>m[1]),backgroundColor:'rgba(216,90,48,.75)',borderColor:'#D85A30',borderWidth:1}
  ],{legend:true});
}

