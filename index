// ══════════════════ GOOGLE SHEETS INTEGRATION ══════════════════
const SHEET_ID = '1klUHysMZyKT4MDX0oMSFROaSGYDQTejAW8STGalBQEA';
const SHEETS_CSV_BASE = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=`;
const MONTH_SHEETS = ['jan26','fev26','mar26','abr26','mai26','jun26','jul26','ago26','set26','out26','nov26','dez26'];
const MONTH_LABELS = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

function parseCSVLine(line){
  const result=[]; let cur=''; let inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'){if(inQ&&line[i+1]==='"'){cur+='"';i++;}else inQ=!inQ;}
    else if(c===','&&!inQ){result.push(cur.trim());cur='';}
    else cur+=c;
  }
  result.push(cur.trim());
  return result;
}

function parseNum(s){
  if(!s||s===''||s==='null')return 0;
  return parseFloat(s.replace(/[^\d,.-]/g,'').replace(',','.').replace(/\.(?=.*\.)/g,''))||0;
}

async function fetchSheet(sheetName){
  const url=SHEETS_CSV_BASE+encodeURIComponent(sheetName);
  const r=await fetch(url);
  if(!r.ok)throw new Error(`Erro ao buscar aba ${sheetName}: ${r.status}`);
  const text=await r.text();
  return text.split('\n').map(l=>parseCSVLine(l));
}

function processSheetRows(rows, monthLabel){
  // Find header row (row with VENDEDOR)
  let headerIdx=-1;
  let colVend=-1,colValor=-1,colProd1=-1,colSetor=-1,colCodigo=-1,colNome=-1,colAgencia=-1,colHist=-1;
  for(let i=0;i<rows.length;i++){
    const r=rows[i];
    const vi=r.findIndex(c=>c.trim()==='VENDEDOR');
    if(vi>=0){headerIdx=i;colVend=vi;break;}
  }
  if(headerIdx<0)return[];
  const h=rows[headerIdx];
  const fc=(n)=>h.findIndex(c=>c.trim()===n);
  colValor=fc('VALOR LÍQUIDO');colProd1=fc('PRODUTO 1');colSetor=fc('SETOR');
  colCodigo=fc('CÓDIGO');colNome=fc('NOME FANTASIA');colAgencia=fc('AGÊNCIA');colHist=fc('HISTÓRICO');

  const data=[];
  for(let i=headerIdx+1;i<rows.length;i++){
    const r=rows[i];
    const vend=colVend>=0?r[colVend]:'';
    const valorStr=colValor>=0?r[colValor]:'';
    if(!vend||!vend.trim()||!valorStr||!valorStr.trim())continue;
    const valor=parseNum(valorStr);
    if(valor<=0)continue;
    data.push({
      mes:monthLabel,
      vendedor:vend.trim(),
      valor,
      produto:colProd1>=0?r[colProd1]?.trim()||null:null,
      setor:colSetor>=0?r[colSetor]?.trim()||null:null,
      codigo:colCodigo>=0?r[colCodigo]?.trim()||null:null,
      nome:colNome>=0?r[colNome]?.trim()||null:null,
      agencia:colAgencia>=0?r[colAgencia]?.trim()||null:null,
      historico:colHist>=0?r[colHist]?.trim()||null:null,
    });
  }
  return data;
}

function rebuildDFromRows(allRows){
  // Group by month
  const byMes={};
  const mesesComDados=[];
  allRows.forEach(r=>{
    if(!byMes[r.mes])byMes[r.mes]=[];
    byMes[r.mes].push(r);
  });

  // Determine which months have data
  Object.keys(byMes).forEach(m=>{if(byMes[m].length>0)mesesComDados.push(m);});

  // Rebuild D object
  const fatVend={},cliVend={},vendasVend={},ticketVend={};
  const prodQtde={},prodValor={};
  const setorValor={},setorVendas={},setorClientes={};
  const mesValor=[],mesVendas=[],mesClientes=[],mesTicket=[];
  const vendMes={};
  const setorMes={};
  const monthly={};

  // Initialize vendor tracking per month
  const vendors=new Set(allRows.map(r=>r.vendedor));
  const setors=new Set(allRows.map(r=>r.setor).filter(Boolean));
  vendors.forEach(v=>{vendMes[v]=[];});
  setors.forEach(s=>{setorMes[s]=[];});

  mesesComDados.forEach(mes=>{
    const rows=byMes[mes];
    const fat=rows.reduce((a,r)=>a+r.valor,0);
    const vendas=rows.length;
    const clientes=new Set(rows.map(r=>r.codigo).filter(Boolean)).size;
    const ticket=vendas>0?fat/vendas:0;
    mesValor.push([mes,Math.round(fat*100)/100]);
    mesVendas.push([mes,vendas]);
    mesClientes.push([mes,clientes]);
    mesTicket.push([mes,Math.round(ticket*100)/100]);

    // Per vendor per month
    vendors.forEach(v=>{
      const vrows=rows.filter(r=>r.vendedor===v);
      vendMes[v].push(Math.round(vrows.reduce((a,r)=>a+r.valor,0)*100)/100);
    });
    setors.forEach(s=>{
      const srows=rows.filter(r=>r.setor===s);
      setorMes[s].push(Math.round(srows.reduce((a,r)=>a+r.valor,0)*100)/100);
    });

    // Monthly detail
    const vendDetail={};
    rows.forEach(r=>{
      if(!vendDetail[r.vendedor])vendDetail[r.vendedor]=[0,0,0];
      vendDetail[r.vendedor][0]+=r.valor;
      vendDetail[r.vendedor][1]++;
      if(r.codigo)vendDetail[r.vendedor][2]++;
    });
    const setorDetail={};
    rows.forEach(r=>{
      if(r.setor){if(!setorDetail[r.setor])setorDetail[r.setor]=0;setorDetail[r.setor]+=r.valor;}
    });
    const prodDetail={};
    rows.forEach(r=>{
      if(r.produto){if(!prodDetail[r.produto])prodDetail[r.produto]=0;prodDetail[r.produto]++;}
    });
    monthly[mes]={fat:Math.round(fat*100)/100,vendas,cli:clientes,ticket:Math.round(ticket*100)/100,vend:vendDetail,setor:setorDetail,prod:prodDetail};
  });

  // Totals
  allRows.forEach(r=>{
    if(!fatVend[r.vendedor])fatVend[r.vendedor]=0;
    fatVend[r.vendedor]+=r.valor;
    if(!vendasVend[r.vendedor])vendasVend[r.vendedor]=0;
    vendasVend[r.vendedor]++;
    if(r.produto){
      if(!prodQtde[r.produto])prodQtde[r.produto]=0; prodQtde[r.produto]++;
      if(!prodValor[r.produto])prodValor[r.produto]=0; prodValor[r.produto]+=r.valor;
    }
    if(r.setor){
      if(!setorValor[r.setor])setorValor[r.setor]=0; setorValor[r.setor]+=r.valor;
      if(!setorVendas[r.setor])setorVendas[r.setor]=0; setorVendas[r.setor]++;
    }
  });

  // Clientes únicos
  vendors.forEach(v=>{
    const codigos=new Set(allRows.filter(r=>r.vendedor===v&&r.codigo).map(r=>r.codigo));
    cliVend[v]=codigos.size;
    ticketVend[v]=vendasVend[v]>0?Math.round(fatVend[v]/vendasVend[v]*100)/100:0;
  });
  setors.forEach(s=>{
    const codigos=new Set(allRows.filter(r=>r.setor===s&&r.codigo).map(r=>r.codigo));
    setorClientes[s]=codigos.size;
  });

  // Sort by value desc
  const sortObj=(o)=>Object.fromEntries(Object.entries(o).sort((a,b)=>b[1]-a[1]));

  // Update global D
  Object.assign(D,{
    fatVend:sortObj(fatVend),
    cliVend:sortObj(cliVend),
    vendasVend,
    ticketVend:sortObj(ticketVend),
    prodQtde:sortObj(prodQtde),
    prodValor:sortObj(prodValor),
    prodTicket:Object.fromEntries(Object.keys(prodValor).map(k=>[k,prodQtde[k]?Math.round(prodValor[k]/prodQtde[k]*100)/100:0])),
    setorValor:sortObj(setorValor),
    setorVendas,
    setorClientes,
    mesValor,mesVendas,mesClientes,mesTicket,
    vendMes,setorMes,monthly,
  });

  // Update MONTHS global
  window.MONTHS_LIVE = mesesComDados;
}

function rebuildAllCharts(){
  // Destroy all existing charts
  document.querySelectorAll('canvas').forEach(c=>{const ch=Chart.getChart(c);if(ch)ch.destroy();});
  // Clear built state
  Object.keys(tabBuilt).forEach(k=>{tabBuilt[k]=false;});
  // Rebuild active tab
  const activeTab=document.querySelector('.nav-tab.active');
  const activeName=activeTab.getAttribute('onclick').match(/'(\w+)'/)[1];
  tabBuilt[activeName]=false;
  if(activeName==='home'){buildHome();}
  else if(activeName==='mensal'){buildMonth(activeMonth);}
  else if(activeName==='comparativo'){buildComparativo();}
  else if(activeName==='vendedores'){buildVendedores();}
  else if(activeName==='setores'){buildSetores();}
  else if(activeName==='produtos'){buildProdutos();}
  else if(activeName==='ticket'){buildTicket();}
  tabBuilt[activeName]=true;
}

function showToast(msg,type){
  let t=document.getElementById('toast');
  if(!t){t=document.createElement('div');t.id='toast';t.style.cssText='position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);padding:10px 20px;border-radius:8px;font-size:13px;font-weight:600;z-index:9999;font-family:Sora,sans-serif;transition:opacity .3s;pointer-events:none';document.body.appendChild(t);}
  t.textContent=msg;
  t.style.background=type==='ok'?'#3B6D11':type==='err'?'#D85A30':'#1A1917';
  t.style.color='#fff';t.style.opacity='1';
  clearTimeout(t._to);t._to=setTimeout(()=>{t.style.opacity='0';},3000);
}

async function refreshData(){
  const btn=document.getElementById('btnUpdate');
  const lbl=document.getElementById('lastUpdate');
  btn.classList.add('loading');
  btn.disabled=true;
  lbl.textContent='Buscando dados…';

  try{
    const allRows=[];
    const results=[];
    // Try fetching each month sheet
    for(let i=0;i<MONTH_SHEETS.length;i++){
      try{
        const rows=await fetchSheet(MONTH_SHEETS[i]);
        const processed=processSheetRows(rows,MONTH_LABELS[i]);
        if(processed.length>0){
          allRows.push(...processed);
          results.push(MONTH_LABELS[i]);
        }
      }catch(e){
        // Month not available yet, skip silently
      }
    }

    if(allRows.length===0){
      throw new Error('Nenhum dado encontrado. Verifique se a planilha está compartilhada publicamente.');
    }

    rebuildDFromRows(allRows);
    rebuildAllCharts();

    const now=new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
    lbl.textContent=`Atualizado ${now} · ${results.join(', ')}`;
    showToast(`✓ Dados atualizados: ${results.length} meses carregados`,'ok');

  }catch(err){
    lbl.textContent='Erro ao atualizar';
    showToast('⚠ '+err.message,'err');
    console.error('Erro refreshData:',err);
  }finally{
    btn.classList.remove('loading');
    btn.disabled=false;
  }
}

