// ══════════════════ HELPERS ══════════════════
function fR(v){return'R$\u00a0'+v.toLocaleString('pt-BR',{minimumFractionDigits:0,maximumFractionDigits:0})}
function fRk(v){return v>=1000?'R$\u00a0'+(v/1000).toLocaleString('pt-BR',{minimumFractionDigits:1,maximumFractionDigits:1})+'k':fR(v)}
function sN(n){const p=n.trim().split(' ');return p[0]+(p.length>1?' '+p[1][0]+'.':'')}
function pct(v,t){return(v/t*100).toFixed(1)+'%'}
function delta(a,b){const d=((b-a)/a*100);return{val:d,str:(d>=0?'+':'')+d.toFixed(1)+'%',cls:d>=0?'delta-up':'delta-down'}}

function renderBars(elId,data,colorFn,fmt,nameW){
  const el=document.getElementById(elId); if(!el)return;
  const entries=Object.entries(data);
  const max=Math.max(...entries.map(e=>e[1]));
  const medals=['🥇','🥈','🥉'];
  el.innerHTML=entries.map((e,i)=>{
    const pct=Math.round(e[1]/max*100);
    const color=typeof colorFn==='string'?colorFn:(colorFn(i));
    return`<div class="bar-row">
      <span class="bar-rank">${medals[i]||(i+1)+'º'}</span>
      <span class="bar-name" style="width:${nameW||130}px" title="${e[0]}">${sN(e[0])}</span>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${color}">
        <span class="bar-val">${fmt(e[1])}</span></div></div></div>`;
  }).join('');
}

function mkChart(id,type,labels,datasets,opts){
  const el=document.getElementById(id); if(!el)return;
  const ctx=el.getContext('2d');
  return new Chart(ctx,{type,data:{labels,datasets},options:{
    responsive:true,maintainAspectRatio:false,
    plugins:{legend:{display:opts&&opts.legend||false,labels:{font:{size:11,family:"'Sora'"},color:'#5F5E5A',boxWidth:10}},
      tooltip:{backgroundColor:'#1A1917',titleColor:'#fff',bodyColor:'rgba(255,255,255,.7)',padding:10,
        callbacks:opts&&opts.tt?opts.tt:{label:ctx=>'\u00a0'+fR(ctx.raw)}}},
    scales:opts&&opts.noScale?{}:{
      x:{grid:{color:'rgba(0,0,0,.05)'},ticks:{color:'#888780',font:{size:11,family:"'DM Mono'"}}},
      y:{grid:{color:'rgba(0,0,0,.05)'},ticks:{color:'#888780',font:{size:10,family:"'DM Mono'"},callback:v=>fRk(v)}}
    },...(opts&&opts.extra||{})
  }});
}

