<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Comercial — Imirante.com 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --brand:#D85A30;--brand-dark:#993C1D;--brand-light:#FAECE7;
  --blue:#185FA5;--blue-light:#E6F1FB;
  --green:#3B6D11;--green-light:#EAF3DE;
  --amber:#BA7517;--amber-light:#FAEEDA;
  --purple:#534AB7;--purple-light:#EEEDFE;
  --teal:#0F6E56;--teal-light:#E0F4EF;
  --gray-50:#F7F6F3;--gray-100:#EEECE8;--gray-200:#D3D1C7;
  --gray-400:#888780;--gray-600:#5F5E5A;--gray-800:#2C2C2A;
  --ink:#1A1917;--page:#F0EEE9;
  --card:#fff;--border:1px solid #EEECE8;
  --radius:12px;--radius-sm:8px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Sora',sans-serif;background:var(--page);color:var(--ink);min-height:100vh}

/* ── NAV ── */
.topbar{background:#fff;border-bottom:var(--border);position:sticky;top:0;z-index:100;box-shadow:0 1px 8px rgba(0,0,0,.06)}
.topbar-inner{max-width:1200px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;gap:0;height:56px}
.logo-pill{background:var(--brand);color:#fff;font-weight:800;font-size:14px;padding:6px 14px;border-radius:6px;letter-spacing:.3px;flex-shrink:0;margin-right:20px}
.nav-tabs{display:flex;gap:0;flex:1;overflow-x:auto}
.nav-tab{padding:0 16px;height:56px;display:flex;align-items:center;font-size:13px;font-weight:500;color:var(--gray-600);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;transition:color .15s,border-color .15s;user-select:none}
.nav-tab:hover{color:var(--ink)}
.nav-tab.active{color:var(--brand);border-bottom-color:var(--brand)}
.topbar-actions{margin-left:auto;display:flex;align-items:center;gap:8px;flex-shrink:0}
.btn-update{display:flex;align-items:center;gap:6px;background:var(--ink);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-family:'Sora',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:background .2s}
.btn-update:hover{background:var(--brand)}
.btn-update svg{transition:transform .4s}
.btn-update.loading svg{animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.btn-pdf{display:flex;align-items:center;gap:6px;background:var(--gray-100);color:var(--ink);border:none;border-radius:8px;padding:8px 14px;font-family:'Sora',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:background .2s}
.btn-pdf:hover{background:var(--gray-200)}
.last-update{font-size:11px;color:var(--gray-400);font-family:'DM Mono',monospace}

/* ── PAGE WRAPPER ── */
.page{max-width:1200px;margin:0 auto;padding:2rem 2rem 4rem;display:none}
.page.active{display:block}

/* ── HERO (Tela Inicial) ── */
.hero{background:linear-gradient(135deg,var(--ink) 0%,#2C2824 100%);border-radius:var(--radius);padding:2.5rem;margin-bottom:1.5rem;color:#fff;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;right:-40px;top:-40px;width:280px;height:280px;background:var(--brand);opacity:.12;border-radius:50%}
.hero::after{content:'';position:absolute;right:60px;bottom:-60px;width:180px;height:180px;background:var(--amber);opacity:.08;border-radius:50%}
.hero-tag{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1.5px;color:rgba(255,255,255,.45);margin-bottom:8px}
.hero-title{font-size:32px;font-weight:800;line-height:1.1;margin-bottom:4px}
.hero-sub{font-size:14px;color:rgba(255,255,255,.55);font-family:'DM Mono',monospace;margin-bottom:2rem}
.hero-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;position:relative;z-index:1}
.hero-kpi{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:var(--radius-sm);padding:1rem 1.25rem;backdrop-filter:blur(4px)}
.hero-kpi-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,.4);margin-bottom:6px}
.hero-kpi-val{font-size:24px;font-weight:700;color:#fff;line-height:1}
.hero-kpi-sub{font-size:11px;color:rgba(255,255,255,.4);margin-top:4px;font-family:'DM Mono',monospace}
.hero-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:600}
.badge-up{background:rgba(59,109,17,.35);color:#8BC34A}
.badge-down{background:rgba(216,90,48,.25);color:#FF8A65}
.badge-na{background:rgba(255,255,255,.1);color:rgba(255,255,255,.4)}

/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.5rem}
.kpi{background:var(--card);border:var(--border);border-radius:var(--radius);padding:1.25rem;position:relative;overflow:hidden}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.kpi-brand::before{background:var(--brand)}
.kpi-blue::before{background:var(--blue)}
.kpi-green::before{background:var(--green)}
.kpi-amber::before{background:var(--amber)}
.kpi-label{font-size:11px;font-weight:500;color:var(--gray-400);text-transform:uppercase;letter-spacing:.8px}
.kpi-val{font-size:26px;font-weight:700;margin-top:4px;line-height:1}
.kpi-sub{font-size:11px;color:var(--gray-400);margin-top:4px;font-family:'DM Mono',monospace}

/* ── LAYOUT GRIDS ── */
.row2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:1.5rem}
.row3{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:14px;margin-bottom:1.5rem}
.row-full{margin-bottom:1.5rem}
.card{background:var(--card);border:var(--border);border-radius:var(--radius);padding:1.25rem}
.card-title{font-size:13px;font-weight:600;margin-bottom:1rem;display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex-shrink:0}

/* ── SECTION LABEL ── */
.slabel{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1.2px;color:var(--gray-400);margin-bottom:10px;display:flex;align-items:center;gap:8px}
.slabel::after{content:'';flex:1;height:.5px;background:var(--gray-200)}

/* ── BAR ROWS ── */
.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.bar-rank{font-family:'DM Mono',monospace;font-size:10px;color:var(--gray-400);width:18px;text-align:center;flex-shrink:0}
.bar-name{font-size:12px;color:var(--gray-600);width:130px;flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-track{flex:1;background:var(--gray-100);border-radius:4px;height:22px;overflow:hidden}
.bar-fill{height:100%;border-radius:4px;display:flex;align-items:center;padding:0 8px}
.bar-val{font-size:10px;font-weight:600;color:#fff;white-space:nowrap;font-family:'DM Mono',monospace}

/* ── RANK LIST ── */
.rank-list{list-style:none}
.rank-item{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:.5px solid var(--gray-100)}
.rank-item:last-child{border-bottom:none}
.rnum{font-family:'DM Mono',monospace;font-size:11px;color:var(--gray-400);width:22px;text-align:center;flex-shrink:0}
.rname{font-size:12px;color:var(--ink);flex:1}
.rval{font-size:12px;font-weight:600;font-family:'DM Mono',monospace}
.rtag{font-size:10px;padding:2px 6px;border-radius:4px;font-weight:500;flex-shrink:0}

/* ── MONTH TABS ── */
.month-tabs{display:flex;gap:6px;margin-bottom:1.5rem;flex-wrap:wrap}
.month-tab{padding:6px 16px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--gray-200);background:#fff;color:var(--gray-600);transition:all .15s;user-select:none}
.month-tab.active{background:var(--brand);color:#fff;border-color:var(--brand)}
.month-tab:hover:not(.active){border-color:var(--brand);color:var(--brand)}
.month-content{display:none}
.month-content.active{display:block}

/* ── COMPARATIVO TABLE ── */
.comp-table{width:100%;border-collapse:collapse;font-size:12px}
.comp-table th{font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--gray-400);font-weight:600;padding:6px 10px;border-bottom:1px solid var(--gray-200);text-align:left}
.comp-table td{padding:9px 10px;border-bottom:.5px solid var(--gray-100);color:var(--ink)}
.comp-table tr:last-child td{border-bottom:none}
.comp-table tr:hover td{background:var(--gray-50)}
.delta-up{color:var(--green);font-weight:600}
.delta-down{color:var(--brand);font-weight:600}
.delta-na{color:var(--gray-400)}

/* ── CHART ── */
.chart-wrap{position:relative}

/* ── INSIGHT STRIP ── */
.istrip{background:var(--ink);border-radius:var(--radius);padding:1.5rem 2rem;display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-bottom:1.5rem}
.iitem{border-left:2px solid rgba(255,255,255,.12);padding-left:1rem}
.ilabel{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,.4);margin-bottom:5px}
.ival{font-size:18px;font-weight:700;color:#fff}
.isub{font-size:11px;color:rgba(255,255,255,.45);margin-top:2px;font-family:'DM Mono',monospace}

/* ── DESTAQUES ── */
.dest-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:1.5rem}
.dest-card{border-radius:var(--radius);padding:1.25rem;border:1px solid transparent}
.db{background:var(--brand-light);border-color:#F5C4B3}.dbl{background:var(--blue-light);border-color:#B5D4F4}
.dg{background:var(--green-light);border-color:#C0DD97}.da{background:var(--amber-light);border-color:#FAC775}
.dp{background:var(--purple-light);border-color:#CECBF6}.dt{background:var(--teal-light);border-color:#9FDDD0}
.dest-tag{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.db .dest-tag{color:var(--brand-dark)}.dbl .dest-tag{color:#0C447C}.dg .dest-tag{color:#27500A}
.da .dest-tag{color:#633806}.dp .dest-tag{color:#3C3489}.dt .dest-tag{color:#064D38}
.dest-name{font-size:16px;font-weight:700;margin-bottom:3px}
.dest-val{font-size:13px;font-family:'DM Mono',monospace;font-weight:600}
.db .dest-val{color:var(--brand)}.dbl .dest-val{color:var(--blue)}.dg .dest-val{color:var(--green)}
.da .dest-val{color:var(--amber)}.dp .dest-val{color:var(--purple)}.dt .dest-val{color:var(--teal)}
.dest-desc{font-size:11px;color:var(--gray-600);margin-top:3px}

/* ── LEGEND ── */
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:8px}
.leg-item{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--gray-600)}
.leg-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}

/* ── PROGRESS ── */
.prog-row{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.prog-name{font-size:12px;color:var(--gray-600);width:140px;flex-shrink:0}
.prog-track{flex:1;height:8px;background:var(--gray-100);border-radius:4px;overflow:hidden}
.prog-fill{height:100%;border-radius:4px}
.prog-val{font-size:11px;font-family:'DM Mono',monospace;font-weight:600;width:70px;text-align:right;flex-shrink:0}

/* ── FOOTER ── */
.footer{border-top:.5px solid var(--gray-200);padding-top:1.5rem;display:flex;justify-content:space-between;align-items:center;margin-top:1rem;font-size:11px;color:var(--gray-400)}
.footer-right{font-family:'DM Mono',monospace}

/* ── PRINT ── */
@media print{
  .topbar,.btn-update,.btn-pdf{display:none!important}
  .page{display:block!important}
  body{background:#fff}
  .hero{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .istrip{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .dest-card{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .bar-fill{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .kpi::before{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}

/* ── NOTE ── */
.note{font-size:11px;color:var(--gray-400);background:var(--amber-light);border:1px solid #FAC775;border-radius:6px;padding:8px 12px;margin-bottom:1.5rem;display:flex;gap:6px;align-items:flex-start}
</style>
</head>
